# Required. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Point the Claude Agent SDK at an alternate Anthropic-compatible
# endpoint. Leave unset for normal use.
# ANTHROPIC_BASE_URL=

# Optional. Port for the Express/SSE backend. Defaults to 8787.
# The Vite dev server proxies /api and /kb here, so if you change it,
# also set BACKEND_ORIGIN for the dev proxy.
# PORT=8787
# BACKEND_ORIGIN=http://localhost:8787
